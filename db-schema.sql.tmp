--
-- Name: millex_audit_user_balance(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.millex_audit_user_balance() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  IF coalesce(NEW."balance", '') IS DISTINCT FROM coalesce(OLD."balance", '') THEN
    INSERT INTO "balance_audit" ("user_id", "field", "old_val", "new_val", "delta", "ctx", "changed_at")
    VALUES (NEW."id", 'balance', OLD."balance", NEW."balance",
      millex_balance_numeric(NEW."balance") - millex_balance_numeric(OLD."balance"),
      left(coalesce(current_setting('millex.req', true), ''), 255), statement_timestamp());
  END IF;
  IF coalesce(NEW."balance_eu", '') IS DISTINCT FROM coalesce(OLD."balance_eu", '') THEN
    INSERT INTO "balance_audit" ("user_id", "field", "old_val", "new_val", "delta", "ctx", "changed_at")
    VALUES (NEW."id", 'balance_eu', OLD."balance_eu", NEW."balance_eu",
      millex_balance_numeric(NEW."balance_eu") - millex_balance_numeric(OLD."balance_eu"),
      left(coalesce(current_setting('millex.req', true), ''), 255), statement_timestamp());
  END IF;
  RETURN NEW;
END;
$$;


--
-- Name: millex_balance_numeric(text); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.millex_balance_numeric(value_text text) RETURNS numeric
    LANGUAGE plpgsql IMMUTABLE
    AS $_$
DECLARE normalized text;
BEGIN
  normalized := replace(replace(btrim(coalesce(value_text, '0')), ' ', ''), ',', '.');
  IF normalized ~ '^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)$' THEN
    RETURN normalized::numeric(20,4);
  END IF;
  RETURN 0;
END;
$_$;


