--
-- Name: users; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.users (
    id integer NOT NULL,
    eauth character varying(255) DEFAULT NULL::character varying,
    moderate integer,
    username character varying(255) DEFAULT NULL::character varying,
    userpercent character varying(255) DEFAULT NULL::character varying,
    balance character varying(255) DEFAULT NULL::character varying,
    balance_eu character varying(255) DEFAULT NULL::character varying,
    avatar text,
    name character varying(255) DEFAULT NULL::character varying,
    auth_key character varying(32) DEFAULT NULL::character varying,
    password_hash character varying(255) DEFAULT NULL::character varying,
    password_reset_token character varying(255) DEFAULT NULL::character varying,
    email character varying(255) DEFAULT NULL::character varying,
    phone character varying(255) DEFAULT NULL::character varying,
    city character varying(255) DEFAULT NULL::character varying,
    last_name character varying(255) DEFAULT NULL::character varying,
    third_name character varying(255) DEFAULT NULL::character varying,
    sex integer,
    rating integer DEFAULT 5,
    street character varying(255) DEFAULT NULL::character varying,
    building character varying(255) DEFAULT NULL::character varying,
    corpus character varying(255) DEFAULT NULL::character varying,
    flat character varying(255) DEFAULT NULL::character varying,
    comment text,
    status integer DEFAULT 1,
    created_at integer,
    updated_at integer,
    confirm integer DEFAULT 0,
    coupone character varying(255) DEFAULT NULL::character varying,
    coupone_percent real DEFAULT '0'::real,
    "timeAdd" timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    sms_code integer DEFAULT 0,
    sms_sendtime character varying(100) DEFAULT '0'::character varying,
    percent integer DEFAULT 0,
    sms_error integer DEFAULT 0,
    phone_verefied integer DEFAULT 0,
    availability integer DEFAULT 0,
    is_admin boolean DEFAULT false NOT NULL,
    is_active boolean DEFAULT true NOT NULL,
    totp_secret character varying(255),
    discount_percent integer DEFAULT 0 NOT NULL,
    token_version integer DEFAULT 0 NOT NULL,
    CONSTRAINT ck_users_discount_percent CHECK (((discount_percent >= 0) AND (discount_percent <= 10)))
);


